# IT Asset System —— 仓库根 compose 环境变量模板（docker-compose.yml 使用）
#
# 使用方法：
#   cp .env.example .env && chmod 600 .env
#   然后把下面的 __CHANGE_ME__ 替换为真实值（生成命令见《P0修复设计方案》§A.3）。
#
# ⚠️ .env 已被仓库根 .gitignore 忽略，严禁提交；本文件仅含占位符，可安全入库。
MYSQL_ROOT_PASSWORD=__CHANGE_ME__
JWT_SECRET=__CHANGE_ME__
DB_PORT=3306
BACKEND_PORT=8080
FRONTEND_PORT=80
SPRING_PROFILES=prod
