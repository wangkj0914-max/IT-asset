# IT Asset System —— 生产环境变量模板（docker/docker-compose.yml 使用）
#
# 使用方法：
#   cp .env.example .env && chmod 600 .env
#   然后把下面的 __CHANGE_ME__ 替换为真实值（生成命令见《P0修复设计方案》§A.3）。
#
# 生成示例（Git Bash）：
#   MYSQL_ROOT_PASSWORD: python -c "import secrets,string; a=string.ascii_letters+string.digits+'._-'; print(''.join(secrets.choice(a) for _ in range(32)))"
#   JWT_SECRET:          python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# ⚠️ .env 已被 docker/.gitignore 忽略，严禁提交；本文件仅含占位符，可安全入库。
MYSQL_ROOT_PASSWORD=__CHANGE_ME__
JWT_SECRET=__CHANGE_ME__
